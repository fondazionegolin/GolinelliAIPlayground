# Database
DB_PASSWORD=your_secure_database_password

# Security
SECRET_KEY=your_very_long_and_secure_secret_key_at_least_32_chars
FEEDBACK_MCP_TOKEN_EXPIRE_DAYS=180

# Platform health light. Leave override empty for automatic probes; set it to
# green/yellow/red with a message during planned maintenance. Enable the GPU
# requirement only on deployments where nvidia-smi is exposed to the API.
PLATFORM_HEALTH_OVERRIDE=
PLATFORM_HEALTH_MESSAGE=
PLATFORM_GPU_REQUIRED=false

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_secure_minio_password

# LLM Providers (optional)
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=your-gemini-api-key
GOLINELLI_IMAGE_API_KEY=your-golinelli-image-api-key
BFL_API_KEY=your-black-forest-labs-api-key

# Realtime voice/video/screen share (LiveKit)
LIVEKIT_URL=wss://your-livekit-host
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_TOKEN_TTL_MINUTES=90

# Grafana
GRAFANA_PASSWORD=admin_secure_password

# Email SMTP (Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=a.saracino@fondazionegolinelli.it
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_EMAIL=a.saracino@fondazionegolinelli.it
SMTP_FROM_NAME=EduAI Platform

# Frontend URL
FRONTEND_URL=https://playground.golinelli.ai

# Additional CORS origins (JSON array, e.g. for staging)
# EXTRA_CORS_ORIGINS=["https://staging.golinelli.ai","http://staging.golinelli.ai"]

# Image generation API
GOLINELLI_IMAGE_API_URL=https://image.golinelli.ai/api/v1
COMPOSE_PROJECT_NAME=dev_golinelli_ai
NGINX_PORT_80=81
NGINX_PORT_443=444
GRAFANA_PORT=3003
