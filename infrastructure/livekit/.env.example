# Docker project name for the standalone LiveKit stack
LIVEKIT_COMPOSE_PROJECT_NAME=eduai-livekit

# Public WebSocket URL used by browsers.
# Local dev:  ws://localhost:7880
# Production: wss://livekit.golinelli.ai
LIVEKIT_URL=wss://livekit.golinelli.ai

# Must match backend .env values LIVEKIT_API_KEY and LIVEKIT_API_SECRET.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-long-random-secret

# Redis reachable from this server.
# Production: IP of the main app server exposing Redis (port 6379 must be open).
# Local dev:  dev_golinelli_ai-redis-1:6379 (Docker hostname on shared network)
LIVEKIT_REDIS_ADDRESS=<IP_MAIN_SERVER>:6379

# Host ports exposed by the standalone LiveKit service.
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_RTC_PORT_RANGE=50000-50100
# Note: LIVEKIT_TURN_UDP_PORT is intentionally absent — TURN runs on turn.golinelli.ai.

# Set to true on a public VM so LiveKit advertises the machine public IP to ICE.
# Must be true on livekit.golinelli.ai; false for local Docker dev.
LIVEKIT_USE_EXTERNAL_IP=true

LIVEKIT_TOKEN_TTL_MINUTES=90
