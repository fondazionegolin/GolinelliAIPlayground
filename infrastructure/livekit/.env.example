# Docker project name for the standalone LiveKit stack
LIVEKIT_COMPOSE_PROJECT_NAME=eduai-livekit

# Public URL used by browsers. For local development use ws://localhost:7880.
# For staging/production use wss://voice.example.org behind TLS.
LIVEKIT_URL=ws://localhost:7880

# Must match backend .env values LIVEKIT_API_KEY and LIVEKIT_API_SECRET.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-long-random-secret

# Reuse the Redis container from the main compose project.
# Default for local repo: dev_golinelli_ai-redis-1 on network dev_golinelli_ai_eduai-network.
LIVEKIT_DOCKER_NETWORK=dev_golinelli_ai_eduai-network
LIVEKIT_REDIS_ADDRESS=dev_golinelli_ai-redis-1:6379

# Host ports exposed by the standalone LiveKit service.
LIVEKIT_HTTP_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882
LIVEKIT_TURN_UDP_PORT=3478
LIVEKIT_RTC_PORT_RANGE=50000-50100

# Set to true on a public VM so LiveKit advertises the machine public IP.
# For local Docker development, false is usually easier.
LIVEKIT_USE_EXTERNAL_IP=false
