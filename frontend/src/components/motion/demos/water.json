 "steps": [
  {
   "at": 0,
   "text": "Due molecole di idrogeno (H₂) e una di ossigeno (O₂): ogni coppia è tenuta insieme da un legame."
  },
  {
   "at": 3.5,
   "text": "Le molecole si avvicinano e si urtano."
  },
  {
   "at": 6.2,
   "text": "Con energia sufficiente i vecchi legami si rompono…"
  },
  {
   "at": 8,
   "text": "…e gli atomi si riorganizzano in nuovi legami."
  },
  {
   "at": 10.2,
   "text": "Si formano due molecole d'acqua (H₂O) e si libera energia."
  }
 ]
